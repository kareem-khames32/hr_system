# ===== HR System API — إعدادات البيئة =====
# انسخ الملف باسم .env وعدّل القيم حسب سيرفرك المحلي

# السيرفر
PORT=4000
NODE_ENV=development

# ===== نوع قاعدة البيانات: mssql أو mysql =====
DB_TYPE=mysql

# --- إعداد MySQL (الشغّال حالياً على جهازك) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your-mysql-root-password
DB_DATABASE=hr_system

# --- إعداد SQL Server (لو رجعت له لاحقاً) ---
# DB_TYPE=mssql
# DB_HOST=localhost
# DB_PORT=1433
# DB_USERNAME=sa
# DB_PASSWORD=YourStrong@Password
# DB_TRUST_SERVER_CERTIFICATE=true

# true لأول تشغيل فقط لإنشاء الجداول تلقائياً — بعدها خليها false
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# CORS — عنوان الفرونت
FRONTEND_URL=http://localhost:3000
