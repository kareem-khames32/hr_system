# ===== HR System API — إعدادات البيئة =====
# انسخ الملف باسم .env وعدّل القيم حسب سيرفرك المحلي

# السيرفر
PORT=4000
NODE_ENV=development

# ===== نوع قاعدة البيانات: mssql أو mysql =====
DB_TYPE=mssql

# --- إعداد SQL Server (الأساسي — container باسم hr-sqlserver) ---
# تشغيل الـ container أول مرة:
#   docker run -d --name hr-sqlserver -e ACCEPT_EULA=Y \
#     -e "MSSQL_SA_PASSWORD=<الباسورد>" -e MSSQL_PID=Express \
#     -p 1433:1433 --restart always -v hr_sql_data:/var/opt/mssql \
#     mcr.microsoft.com/mssql/server:2022-latest
# تحذير: تجنّب # أو $ في الباسورد — بيكسروا قراءة .env
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourStrong-Password12
DB_DATABASE=hr_system
DB_TRUST_SERVER_CERTIFICATE=true

# --- إعداد MySQL (بديل — غيّر DB_TYPE إلى mysql) ---
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=your-mysql-root-password
# DB_DATABASE=hr_system

# true لأول تشغيل فقط لإنشاء الجداول تلقائياً — بعدها خليها false
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# CORS — عنوان الفرونت
FRONTEND_URL=http://localhost:3000
