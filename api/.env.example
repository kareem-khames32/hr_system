# ===== HR System API — إعدادات البيئة =====
# انسخ الملف باسم .env وعدّل القيم حسب سيرفرك المحلي

# السيرفر
PORT=4000
NODE_ENV=development

# SQL Server المحلي
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourStrong@Password
DB_DATABASE=hr_system
# true لأول تشغيل فقط لإنشاء الجداول تلقائياً — بعدها خليها false واستخدم DDL
DB_SYNCHRONIZE=true
# لو SQL Server على نفس الجهاز بدون شهادة TLS
DB_TRUST_SERVER_CERTIFICATE=true

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# CORS — عنوان الفرونت
FRONTEND_URL=http://localhost:3000
