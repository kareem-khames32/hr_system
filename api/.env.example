# ===== HR System API — إعدادات البيئة =====
# انسخ الملف باسم .env وعدّل القيم حسب سيرفرك المحلي

# Runtime minimum: Node.js >=22.12.0 (use a currently patched release)
# Production requires NODE_ENV=production and DB_SYNCHRONIZE=false
# السيرفر
PORT=4000
NODE_ENV=development

# ===== نوع قاعدة البيانات: mssql أو mysql =====
DB_TYPE=mssql

# --- إعداد SQL Server (الأساسي — container باسم hr-sqlserver) ---
# تشغيل الـ container أول مرة:
#   docker run -d --name hr-sqlserver -e ACCEPT_EULA=Y \
#     -e "MSSQL_SA_PASSWORD=<الباسورد>" -e MSSQL_PID=Express \
#     -p 1433:1433 --restart always -v hr_sql_data:/var/opt/mssql \
#     mcr.microsoft.com/mssql/server:2022-latest
# تحذير: تجنّب # أو $ في الباسورد — بيكسروا قراءة .env
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourStrong-Password12
DB_DATABASE=hr_system
DB_TRUST_SERVER_CERTIFICATE=true

# --- إعداد MySQL (بديل — غيّر DB_TYPE إلى mysql) ---
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=your-mysql-root-password
# DB_DATABASE=hr_system

# ممنوع true على قاعدة الشركة: الإقلاع يرفض المزامنة لأي قاعدة ليست قاعدة اختبار مؤقتة
# (hr_<اسم>_test_<16 hex>). تغييرات المخطط والبيانات بالمُرحّل المجمّع: docs/migrations/README.md
DB_SYNCHRONIZE=false

# JWT — إلزامي، 32 حرف على الأقل وعشوائي (الإقلاع يفشل بدونه). القيمة التالية
# منشورة ومرفوضة في production؛ ولّد سراً بـ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# CORS — عنوان الفرونت
FRONTEND_URL=http://localhost:3000

# ربط الـAPI محليًا (الافتراضي 127.0.0.1)؛ 0.0.0.0 فقط لو مطلوب الوصول من الشبكة عمدًا
API_HOST=127.0.0.1

# المنطقة الزمنية للشركة — تحكم تواريخ الحضور وحدود دورة الرواتب (Africa/Cairo وAsia/Riyadh يختلفان جزءًا من السنة)
TZ=Africa/Cairo

# مسار مطلق دائم لمجلد الملفات المرفوعة (أسماء الملفات المخزنة نسبية له) — انسخه احتياطيًا مع قاعدة البيانات
UPLOADS_ROOT=D:/projects/hr_system/api/uploads

# Chrome الذي يحتاجه puppeteer لتوليد PDF (افحصه بـ node api/scripts/env-check.cjs --launch)
# PUPPETEER_EXECUTABLE_PATH=C:/Users/<user>/.cache/puppeteer/chrome/win64-148.0.7778.97/chrome-win64/chrome.exe
