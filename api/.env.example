# ===== HR System API — إعدادات البيئة =====
# انسخ الملف باسم .env وعدّل القيم حسب سيرفرك المحلي

# Runtime minimum: Node.js >=22.12.0 (use a currently patched release)
# Production requires NODE_ENV=production and DB_SYNCHRONIZE=false
# السيرفر
PORT=4000
NODE_ENV=development

# ===== نوع قاعدة البيانات: mssql أو mysql =====
DB_TYPE=mssql

# --- إعداد SQL Server (الأساسي — container باسم hr-sqlserver) ---
# تشغيل الـ container أول مرة:
#   docker run -d --name hr-sqlserver -e ACCEPT_EULA=Y \
#     -e "MSSQL_SA_PASSWORD=<الباسورد>" -e MSSQL_PID=Express \
#     -p 1433:1433 --restart always -v hr_sql_data:/var/opt/mssql \
#     mcr.microsoft.com/mssql/server:2022-latest
# تحذير: تجنّب # أو $ في الباسورد — بيكسروا قراءة .env
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourStrong-Password12
DB_DATABASE=hr_system
DB_TRUST_SERVER_CERTIFICATE=true

# --- إعداد MySQL (بديل — غيّر DB_TYPE إلى mysql) ---
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=your-mysql-root-password
# DB_DATABASE=hr_system

# ممنوع true على قاعدة الشركة: الإقلاع يرفض المزامنة لأي قاعدة ليست قاعدة اختبار مؤقتة
# (hr_<اسم>_test_<16 hex>). تغييرات المخطط والبيانات بالمُرحّل المجمّع: docs/migrations/README.md
DB_SYNCHRONIZE=false

# JWT — إلزامي، 32 حرف على الأقل وعشوائي (الإقلاع يفشل بدونه). القيمة التالية
# منشورة ومرفوضة في production؛ ولّد سراً بـ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# CORS — عنوان الفرونت
FRONTEND_URL=http://localhost:3000

# ربط الـAPI محليًا (الافتراضي 127.0.0.1)؛ 0.0.0.0 فقط لو مطلوب الوصول من الشبكة عمدًا
API_HOST=127.0.0.1

# المنطقة الزمنية للشركة — تحكم تواريخ الحضور وحدود دورة الرواتب (Africa/Cairo وAsia/Riyadh يختلفان جزءًا من السنة)
TZ=Africa/Cairo

# مسار مطلق دائم لمجلد الملفات المرفوعة (أسماء الملفات المخزنة نسبية له) — انسخه احتياطيًا مع قاعدة البيانات
UPLOADS_ROOT=D:/projects/hr_system/api/uploads

# Chrome الذي يحتاجه puppeteer لتوليد PDF (افحصه بـ node api/scripts/env-check.cjs --launch)
# PUPPETEER_EXECUTABLE_PATH=C:/Users/<user>/.cache/puppeteer/chrome/win64-148.0.7778.97/chrome-win64/chrome.exe

# =====================================================================================
# الدخول بحساب الشركة — Active Directory عادي على الشبكة (بلا Entra ولا ADFS)
# =====================================================================================
# المجال بيثبت الهوية بس. الأدوار والصلاحيات ونطاق الفروع بيفضلوا من جداول النظام —
# ولا مجموعة AD واحدة بتتقري ولا بتمنح أي صلاحية.
# مقفول بالكامل لحد ما AD_HOST يتكتب: بدونه زر «الدخول بحساب الشركة» مايظهرش خالص.
# أول دخول ناجح بحساب مجال بيطابق الموظف ويعمل الحساب ويربطه (بلا إنشاء مسبق لـ485 حساب).
# الربط بـobjectGUID الثابت: إعادة تسمية الحساب أو تغيير بريده في AD مابتكسرش الربط.
#
# AD_ENABLED=false يقفل المسار بلا مسح باقي الإعداد (الافتراضي مفتوح لو AD_HOST مكتوب)
# AD_ENABLED=true
# اسم أو IP الـDomain Controller
# AD_HOST=dc01.maharah.local
# 636 مع LDAPS، و389 بدونه (القيمة الافتراضية بتتحدد من AD_LDAPS)
# AD_PORT=636
# ⚠️ AD_LDAPS=false معناها كلمات مرور المجال بتنتقل على الشبكة بلا تشفير — الخادم بيطبع
#    تحذير صريح وقت الإقلاع ومابيعتبرهاش وضعًا طبيعيًّا. اشتغل بـtrue على شهادة الـDC.
# AD_LDAPS=true
# false = مانتحققش من شهادة الـDC (شهادة موقّعة داخليًّا) — تحذير إقلاع كذلك. الأفضل تثبيت
# شهادة الشركة على الخادم وترك القيمة true.
# AD_TLS_REJECT_UNAUTHORIZED=true
# جذر البحث عن الحسابات
# AD_BASE_DN=DC=maharah,DC=local
# لاحقة الـUPN: الموظف بيكتب «name» أو «name@maharah.local» والاتنين بيشتغلوا
# AD_UPN_SUFFIX=maharah.local
# حساب خدمة للقراءة فقط (اختياري): بدونه بنقرا خصائص الحساب على اتصال الموظف نفسه.
# ⚠️ ممنوع يكون حساب مدير مجال — قراءة بس. الكلمة دي مابتتطبعش ولا بتتسجّل ولا بترجع في أي رد.
# AD_BIND_DN=svc-hr-read@maharah.local
# AD_BIND_PASSWORD=
# مهلة الاتصال والبحث بالمللي (الافتراضي 8000، الحد الأدنى 1000)
# AD_TIMEOUT_MS=8000

# =====================================================================================
# إرسال البريد (SMTP) — لازم لرمز التحقق بخطوتين
# =====================================================================================
# التحقق بخطوتين بيتسلّم **مقفول** (requests_config: auth.two_factor_enabled = 'false').
# افحص البريد الأول:   node api/scripts/mail-selftest.cjs <عنوان>
# وبعدها افتحه من:      الإعدادات ← سياسات النظام ← «الدخول والأمان»
# مفتاح الطوارئ لقفله من الخادم بلا تطبيق:  node api/scripts/two-factor-off.cjs
# فشل البريد **مابيدخّلش حد**: الدخول يُرفض برسالة بالسبب ويُسجَّل على الخادم.
#
# SMTP_HOST=mail.maharah.pro
# 587 مع STARTTLS، و465 مع SMTP_SECURE=true
# SMTP_PORT=587
# true = TLS من أول لحظة (465)
# SMTP_SECURE=false
# STARTTLS إلزامي على 587 (الافتراضي true لما SMTP_SECURE=false) — ⚠️ false معناها رموز بلا تشفير
# SMTP_REQUIRE_TLS=true
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# المُرسِل الظاهر في الرسالة (إلزامي مع SMTP_HOST)
# SMTP_FROM=نظام الموارد البشرية <hr-noreply@maharah.pro>
# مصادقة اختيارية (السيرفر الداخلي المفتوح للشبكة مايحتاجهاش) — الكلمة مابتتطبعش أبدًا
# SMTP_USER=hr-noreply@maharah.pro
# SMTP_PASSWORD=
# مهلة الاتصال والإرسال بالمللي (الافتراضي 15000، الحد الأدنى 1000)
# SMTP_TIMEOUT_MS=15000
