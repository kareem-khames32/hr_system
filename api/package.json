{
  "name": "hr-system-api",
  "version": "0.1.0",
  "description": "HR System Backend — NestJS + SQL Server",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "seed": "ts-node src/seed/seed.ts",
    "reset": "ts-node src/seed/reset.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --test --test-concurrency=1 test/*.integration.cjs test/*.test.cjs",
    "preview:test": "node test/preview.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "11.0.3",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "ldapts": "^7.4.0",
    "mssql": "12.7.2",
    "mysql2": "3.24.4",
    "node-zklib": "^1.3.0",
    "nodemailer": "^7.0.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "puppeteer": "25.10.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "multer": "2.3.0",
    "brace-expansion": "2.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
